# Public application configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local checkout simulator. It is automatically disabled in production.
COMMERCE_MODE=demo
# A deliberate second switch that prevents accidental payment activation.
DODO_CHECKOUT_ENABLED=false

# Supabase (safe to expose in browser code; RLS protects the data)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase server-only credential — never prefix this with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Dodo Payments server-only credentials
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_LIVE_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_LIVE_WEBHOOK_KEY=
DODO_PAYMENTS_RETURN_URL=http://localhost:3000/checkout/success
# Required when an order below the free-shipping threshold needs a Dodo shipping SKU.
DODO_SHIPPING_PRODUCT_ID=
DODO_PAYMENTS_LIVE_SHIPPING_PRODUCT_ID=

# PrintKK print-on-demand fulfillment (server-only; never prefix with NEXT_PUBLIC_)
# Keep the API key's ak- prefix from PrintKK; the secret key uses sk-.
PRINTKK_API_KEY=
PRINTKK_SECRET_KEY=
PRINTKK_API_BASE_URL=https://api.printkk.com
PRINTKK_POSTER_PRODUCT_CODE=A72TS0
PRINTKK_FULFILLMENT_MODE=disabled
# A PrintKK wallet must have enough balance before fulfillment is enabled.
PRINTKK_SHIPPING_PRIORITY=standard,economy,express

# One owner-only, supplier-wallet test. This is never a customer checkout.
# Keep disabled except while you intentionally perform the test.
PRINTKK_MANUAL_TEST_ENABLED=false
PRINTKK_TEST_ADMIN_EMAIL=

# Protects the scheduled fulfillment/polling endpoint.
CRON_SECRET=
